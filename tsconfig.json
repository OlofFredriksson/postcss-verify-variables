{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "paths": {
            "postcss-verify-variables": ["./src/index.ts"],
            "postcss-verify-variables/vite": ["./src/vite.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
